guiTypes = {
	containerWindowType = {
        name = "eyes_diplomacy_launcher_window"
        position = { x = 18 y = 108 }
        size = { width = 148 height = 34 }
        Orientation = upper_left
        clipping = no
        buttonType = {
            name = "eyes_diplomacy_open_button"
            position = { x = 0 y = 0 }
            size = { x = 148 y = 34 }
            quadTextureSprite = "GFX_button_148x34"
            buttonText = "HOI4-EYES"
            buttonFont = "cg_16b"
            pdx_tooltip = "EYES_DIPLOMACY_OPEN"
            clicksound = click_action
        }
    }

	containerWindowType = {
		name = "eyes_diplomacy_panel_window"
		position = { x = 30 y = 100 }
		size = { width = 460 height = 570 }
