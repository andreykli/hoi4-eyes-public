			font = "hoi_18mbs"
			text = "EYES_DIPLOMACY_AVAILABLE"
			maxWidth = 425
			maxHeight = 24
		}

		containerWindowType = {
			name = "eyes_country_list_viewport"
			position = { x = 18 y = 190 }
